<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="holonomic">

    <!-- Existing chassis/wheels body (unchanged from the original Classic model) -->
    <xacro:include filename="robot_core_highres.xacro"/>
    <!--<xacro:include filename="robot_core.xacro"/>--> <!--Uncomment to use low res mode-->

    <!-- New for Gazebo Harmonic -->
    <xacro:include filename="lidar.xacro"/>
    <xacro:include filename="imu.xacro"/>
    <xacro:include filename="holonomic_drive_gz.xacro"/>

</robot>
