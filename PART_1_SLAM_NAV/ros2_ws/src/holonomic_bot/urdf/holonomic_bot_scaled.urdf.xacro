<?xml version="1.0"?>
<robot name="holonomic_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    This URDF is used ONLY by robot_state_publisher, to give ROS a TF tree
    and something to show in RViz. It intentionally does NOT contain any
    Gazebo <plugin> or friction tags.

    The actual simulated robot that gets spawned into Gazebo is the native
    SDF file at models/holonomic_bot/model.sdf. Native SDF is used for the
    sim model (instead of converting this URDF) because the per-wheel
    friction-direction trick that makes mecanum wheels behave holonomically
    relies on an `expressed_in` attribute that does not survive the
    URDF -> SDF conversion reliably, and can even make robot_state_publisher
    refuse to parse the URDF. Keeping the two descriptions separate avoids
    both problems. Wheel joints here are fixed (no joint_state_publisher
    needed) since visually spinning wheels aren't needed for SLAM/nav.

    Geometry below matches model.sdf: keep them in sync if you resize the robot.
  -->

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="base_x" value="0.60"/>
  <xacro:property name="base_y" value="0.48"/>
  <xacro:property name="base_z" value="0.16"/>

  <material name="blue">
    <color rgba="0.2 0.4 0.8 1"/>
  </material>
  <material name="dark">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <inertia ixx="0.01333" ixy="0" ixz="0" iyy="0.02008" iyz="0" izz="0.03075"/>
    </inertial>
  </link>

  <!-- Wheels: fixed joints here (TF only, no simulated rotation) -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000105" ixy="0" ixz="0" iyy="0.0001875" iyz="0" izz="0.000105"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left"  x="0.20"  y="0.27"/>
  <xacro:wheel name="front_right" x="0.20"  y="-0.27"/>
  <xacro:wheel name="rear_left"   x="-0.20" y="0.27"/>
  <xacro:wheel name="rear_right"  x="-0.20" y="-0.27"/>

  <!-- Lidar -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.07" length="0.08"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.07" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000022" ixy="0" ixz="0" iyy="0.000022" iyz="0" izz="0.0000306"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
  </joint>

</robot>
