<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="holonomic_bot" canonical_link="base_link">
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- ================= CHASSIS ================= -->
    <!-- Base link frame is at ground level. The chassis geometry is centered at z=0.30 m. -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0.30 0 0 0</pose>
        <mass>540.0</mass>
        <inertia>
          <ixx>103.68</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>156.168</iyy>
          <iyz>0</iyz>
          <izz>239.112</izz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry>
          <box>
            <size>1.80 1.44 0.48</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.8 1</ambient>
          <diffuse>0.2 0.4 0.8 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="base_collision">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry>
          <box>
            <size>1.80 1.44 0.48</size>
          </box>
        </geometry>
      </collision>

      <!-- ================= LIDAR ================= -->
      <visual name="lidar_visual">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.21</radius>
            <length>0.24</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <collision name="lidar_collision">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.21</radius>
            <length>0.24</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
        <topic>/model/holonomic_bot/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>

      <!-- ================= IMU ================= -->
      <sensor name="imu_sensor" type="imu">
        <pose relative_to="imu_link">0 0 0 0 0 0</pose>
        <topic>/model/holonomic_bot/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <gravity>true</gravity>
      </sensor>
    </link>

    <!-- Sensor frames used by the lidar / IMU messages and ROS TF. -->
    <frame name="lidar_link" attached_to="base_link">
      <pose>0 0 0.72 0 0 0</pose>
    </frame>

    <frame name="imu_link" attached_to="base_link">
      <pose>0 0 0.30 0 0 0</pose>
    </frame>

    <!-- ================= WHEELS ================= -->
    <!--
      Wheel centres are at z=0.30 m, matching the 0.30 m wheel radius.
      Link rotation keeps the cylinder axis along the lateral wheel axis.
      The MecanumDrive system uses these four revolute joints.
    -->

    <link name="front_left_wheel">
      <pose>0.60 0.81 0.30 1.57079632679 0 0</pose>
      <inertial>
        <mass>32.4</mass>
        <!-- Cylinder principal axis is local Z. -->
        <inertia>
          <ixx>0.81648</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.81648</iyy>
          <iyz>0</iyz>
          <izz>1.458</izz>
        </inertia>
      </inertial>
      <visual name="front_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="front_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 expressed_in="base_link">1 -1 0</fdir1>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>1.0</max_vel>
              <min_depth>0.0</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <pose relative_to="base_link">0.60 0.81 0.30 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="front_right_wheel">
      <pose>0.60 -0.81 0.30 1.57079632679 0 0</pose>
      <inertial>
        <mass>32.4</mass>
        <inertia>
          <ixx>0.81648</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.81648</iyy>
          <iyz>0</iyz>
          <izz>1.458</izz>
        </inertia>
      </inertial>
      <visual name="front_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="front_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 expressed_in="base_link">1 1 0</fdir1>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>1.0</max_vel>
              <min_depth>0.0</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="front_right_wheel_joint" type="revolute">
      <pose relative_to="base_link">0.60 -0.81 0.30 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="rear_left_wheel">
      <pose>-0.60 0.81 0.30 1.57079632679 0 0</pose>
      <inertial>
        <mass>32.4</mass>
        <inertia>
          <ixx>0.81648</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.81648</iyy>
          <iyz>0</iyz>
          <izz>1.458</izz>
        </inertia>
      </inertial>
      <visual name="rear_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="rear_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 expressed_in="base_link">1 1 0</fdir1>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>1.0</max_vel>
              <min_depth>0.0</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <pose relative_to="base_link">-0.60 0.81 0.30 0 0 0</pose>
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="rear_right_wheel">
      <pose>-0.60 -0.81 0.30 1.57079632679 0 0</pose>
      <inertial>
        <mass>32.4</mass>
        <inertia>
          <ixx>0.81648</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.81648</iyy>
          <iyz>0</iyz>
          <izz>1.458</izz>
        </inertia>
      </inertial>
      <visual name="rear_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="rear_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 expressed_in="base_link">1 -1 0</fdir1>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>1.0</max_vel>
              <min_depth>0.0</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="rear_right_wheel_joint" type="revolute">
      <pose relative_to="base_link">-0.60 -0.81 0.30 0 0 0</pose>
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ================= JOINT STATES ================= -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>

    <!-- ================= HOLONOMIC DRIVE ================= -->
    <plugin filename="gz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>

      <!-- Actual centre-to-centre geometry of this 6x robot. -->
      <wheel_separation>1.62</wheel_separation>
      <wheelbase>1.20</wheelbase>
      <wheel_radius>0.30</wheel_radius>

      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
      <min_velocity>-2</min_velocity>
      <max_velocity>2</max_velocity>

      <topic>cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <tf_topic>pose_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
