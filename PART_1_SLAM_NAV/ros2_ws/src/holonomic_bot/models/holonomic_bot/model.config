<?xml version="1.0"?>
<model>
  <name>holonomic_bot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>you</name>
  </author>
  <description>
    4-wheel mecanum holonomic mobile robot with a 2D GPU lidar, built for
    Gazebo Harmonic. Spawned as native SDF (not converted from URDF) so the
    per-wheel friction-direction trick that makes mecanum wheels behave
    holonomically survives intact.
  </description>
</model>
