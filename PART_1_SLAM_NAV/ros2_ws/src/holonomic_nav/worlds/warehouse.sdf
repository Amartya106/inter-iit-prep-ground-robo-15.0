<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">

    <!-- Core gz-sim systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ogre2 is required for gpu_lidar sensors -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- required by every <sensor type="imu"> in the world -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- needed by the JointController plugins used by the robot's holonomic drive -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      Inline ground plane.

      This is defined directly here so Gazebo does not need to resolve
      model://ground_plane from a model search path.
    -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!--
      OpenRobotics Warehouse model, pulled from the Gazebo Fuel catalog.
      Requires internet access on first run if not already cached.
    -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Warehouse
      </uri>
      <name>warehouse</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Warehouse shelves -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01
      </uri>
      <name>shelf_1</name>
      <pose>4 15 0 0 0 1.57</pose>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01
      </uri>
      <name>shelf_2</name>
      <pose>1 -2 0 0 0 1.57</pose>
    </include>

    <!-- Clutter -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ClutteringA_01
      </uri>
      <name>clutter_1</name>
      <pose>4 2 0 0 0 0</pose>
    </include>

    <!-- Additional shelf -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/Abdurrahman/models/aws_robomaker_warehouse_ShelfD_01
      </uri>
      <name>shelf_3</name>
      <pose>12 -13 0 0 0 1.57</pose>
    </include>

    <!-- Large shelves -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big
      </uri>
      <name>shelf_4</name>
      <pose>-13 -13 0 0 0 0</pose>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big
      </uri>
      <name>shelf_5</name>
      <pose>4 -13 0 0 0 1.57</pose>
    </include>

  </world>
</sdf>